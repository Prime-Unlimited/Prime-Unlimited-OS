{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prime Unlimited trusted mod catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "mods", "libraries"],
  "properties": {
    "schemaVersion": {"const": 2},
    "catalogId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "authenticity": {
      "type": "object",
      "description": "Transported signature metadata. Verification is performed against deployment-owned trust roots, never this object alone.",
      "required": ["algorithm", "keyId", "signature"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "keyId": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "mods": {"type": "array", "items": {"$ref": "#/$defs/mod"}},
    "libraries": {"type": "array", "items": {"$ref": "#/$defs/library"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "compatibility": {
      "type": "object",
      "required": ["models", "architecture", "abi"],
      "properties": {
        "models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "firmware": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "firmwareConstraint": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "abi": {"type": "string", "minLength": 1}
      }
    },
    "package": {
      "type": "object",
      "required": ["downloadUrl", "sha256", "size"],
      "properties": {
        "downloadUrl": {"type": "string", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size": {"type": "integer", "minimum": 1, "maximum": 134217728}
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "constraint"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "constraint": {"type": "string", "minLength": 1},
        "type": {"enum": ["mod", "library"]}}
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["maintainer", "devices"],
      "properties": {"maintainer": {"type": "string", "minLength": 1},
        "devices": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "mod": {
      "allOf": [{"$ref": "#/$defs/compatibility"}, {"$ref": "#/$defs/package"}],
      "type": "object",
      "required": ["id", "name", "version", "models", "architecture", "abi", "downloadUrl", "sha256", "size", "entrypoint", "approval"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 0},
        "description": {"type": "string"}, "models": {}, "firmware": {}, "firmwareConstraint": {}, "architecture": {}, "abi": {},
        "downloadUrl": {}, "sha256": {}, "size": {}, "entrypoint": {"type": "string", "pattern": "^[^/\\\\][^\\\\]*$"},
        "approval": {"$ref": "#/$defs/approval"}, "overlay": {"type": "string", "pattern": "^[^/\\\\][^\\\\]*\\.qml$"}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "libraries": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "revoked": {"type": "boolean"},
        "update": {"type": "object", "properties": {"channel": {"type": "string"}, "replaces": {"type": "array", "items": {"type": "string"}}}}
      }
    },
    "library": {
      "allOf": [{"$ref": "#/$defs/compatibility"}, {"$ref": "#/$defs/package"}],
      "type": "object",
      "required": ["id", "name", "version", "models", "architecture", "abi", "downloadUrl", "sha256", "size", "approval"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "version": {"type": "string"},
        "models": {}, "firmware": {}, "firmwareConstraint": {}, "architecture": {}, "abi": {}, "downloadUrl": {}, "sha256": {}, "size": {},
        "approval": {"$ref": "#/$defs/approval"}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "revoked": {"type": "boolean"}
      }
    }
  }
}
